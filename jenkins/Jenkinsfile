// ──────────────────────────────────────────────────────────────────────────
//  Pipeline CI/CD — Gym Reserva
//  1) Construye la imagen del backend
//  2) Corre las pruebas unitarias DENTRO de esa imagen (Django + mongomock),
//     montando tests/ desde el repositorio: la imagen de producción no las lleva
//  3) Construye la imagen del frontend (build de producción nginx)
//  4) Publica ambas en Docker Hub (usuario ocamilavillero09)
//  ArgoCD detecta la imagen :latest y la despliega en el cluster de minikube.
//
//  Notas:
//   - Las pruebas viven en tests/ (raíz del repositorio), fuera de backend/ y
//     de frontend/, así que no entran en la imagen. Se montan en /app/tests solo
//     para esta etapa: lo que se publica no lleva código de pruebas dentro.
//   - Requiere una credencial "Username with password" con ID: dockerhub-creds
// ──────────────────────────────────────────────────────────────────────────
pipeline {
  agent any

  environment {
    DOCKERHUB_USER = 'ocamilavillero09'
    BACKEND_IMAGE  = "${DOCKERHUB_USER}/gym-backend"
    FRONTEND_IMAGE = "${DOCKERHUB_USER}/gym-frontend"
    IMAGE_TAG      = "${env.BUILD_NUMBER}"
  }

  stages {

    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Build backend') {
      steps {
        sh 'docker build -f backend/dockerfile -t $BACKEND_IMAGE:$IMAGE_TAG -t $BACKEND_IMAGE:latest ./backend'
      }
    }

    stage('Pruebas unitarias (backend)') {
      // Si las pruebas fallan, el pipeline se detiene y NO se publica nada.
      steps {
        sh '''docker run --rm \
                -v "$WORKSPACE/tests:/app/tests:ro" \
                -e PYTHONDONTWRITEBYTECODE=1 \
                $BACKEND_IMAGE:$IMAGE_TAG python manage.py test tests.backend -v 2'''
      }
    }

    stage('Build frontend') {
      steps {
        sh 'docker build -f frontend/Dockerfile.prod -t $FRONTEND_IMAGE:$IMAGE_TAG -t $FRONTEND_IMAGE:latest ./frontend'
      }
    }

    stage('Push a Docker Hub') {
      steps {
        withCredentials([usernamePassword(credentialsId: 'dockerhub-creds',
                                           usernameVariable: 'DH_USER',
                                           passwordVariable: 'DH_PASS')]) {
          sh 'echo "$DH_PASS" | docker login -u "$DH_USER" --password-stdin'
          sh 'docker push $BACKEND_IMAGE:$IMAGE_TAG'
          sh 'docker push $BACKEND_IMAGE:latest'
          sh 'docker push $FRONTEND_IMAGE:$IMAGE_TAG'
          sh 'docker push $FRONTEND_IMAGE:latest'
        }
      }
    }
  }

  post {
    always {
      sh 'docker logout || true'
    }
    success {
      echo "✅ Imágenes publicadas: $BACKEND_IMAGE:$IMAGE_TAG y $FRONTEND_IMAGE:$IMAGE_TAG"
    }
    failure {
      echo '❌ Pipeline falló. Revisa los logs de la etapa correspondiente.'
    }
  }
}
