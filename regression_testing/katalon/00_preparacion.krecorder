<tr><td>runScript</td><td>var s=Object.getOwnPropertyDescriptor(HTMLInputElement.prototype,&#x27;value&#x27;).set; var e=document.getElementById(&#x27;login-nombre&#x27;); s.call(e,&#x27;Katalon Entrenador&#x27;); e.dispatchEvent(new Event(&#x27;input&#x27;,{bubbles:true}));<datalist><option>var s=Object.getOwnPropertyDescriptor(HTMLInputElement.prototype,&#x27;value&#x27;).set; var e=document.getElementById(&#x27;login-nombre&#x27;); s.call(e,&#x27;Katalon Entrenador&#x27;); e.dispatchEvent(new Event(&#x27;input&#x27;,{bubbles:true}));</option></datalist></td><td></td></tr>
