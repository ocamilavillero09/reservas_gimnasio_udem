# Proveedor de IA: openai, gemini u ollama.
AI_PROVIDER=ollama

# Navegador local. CHROME_PATH es opcional si Chrome se detecta solo.
HEADLESS=false
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
STAGEHAND_LOG_LEVEL=info

# App del gimnasio (los mismos valores que usa Cypress).
GIMNASIO_URL=http://localhost:5173
GIMNASIO_API_URL=http://localhost:8000/api
MONGO_URI=mongodb://localhost:27017
MONGO_DB=gym_udem

# OpenAI (clave de la API, no la suscripción de ChatGPT).
OPENAI_API_KEY=
OPENAI_MODEL=openai/gpt-4.1-mini

# Google Gemini.
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=google/gemini-2.5-flash

# Ollama local.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=qwen2.5:7b
