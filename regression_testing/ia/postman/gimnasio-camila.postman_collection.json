    {
      "name": "RF21 — Buzón",
      "item": [
        {
          "name": "Consultar buzón",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": {
              "raw": "{{base}}/suggestions/inbox/?actor_email={{admin_email}}",
              "host": [
                "{{base}}"
              ],
              "path": [
                "suggestions",
                "inbox"
              ],
              "query": [
                {
                  "key": "actor_email",
                  "value": "{{admin_email}}"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const m = pm.response.json().mensajes || [];",
                  "if (m.length) pm.collectionVariables.set('sugerencia_id', m[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Borrar mensaje",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": {
              "raw": "{{base}}/suggestions/{{sugerencia_id}}/?actor_email={{admin_email}}",
              "host": [
                "{{base}}"
              ],
              "path": [
                "suggestions",
                "{{sugerencia_id}}"
              ],
              "query": [
                {
                  "key": "actor_email",
                  "value": "{{admin_email}}"
                }
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Estudiante no ve el buzón → 403",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
