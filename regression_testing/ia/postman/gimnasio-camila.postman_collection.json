  },
  "variable": [
    {
      "key": "base",
      "value": "http://localhost:8000/api"
    },
    {
      "key": "entrenador_email",
      "value": "tomas.coach@udem.edu.co"
    },
    {
      "key": "entrenador_doc",
      "value": "1000000002"
    },
    {
      "key": "admin_email",
      "value": "ana.admin@udemedellin.edu.co"
    },
    {
      "key": "admin_doc",
      "value": "1000000001"
    },
    {
      "key": "estudiante_email",
      "value": "laura.est@soyudemedellin.edu.co"
    },
    {
      "key": "estudiante_doc",
      "value": "1000000003"
    },
    {
      "key": "token_entrenador",
      "value": ""
