                "key": "Authorization",
                "value": "Bearer {{token_entrenador}}"
              }
            ],
            "url": {
              "raw": "{{base}}/students/lookup/?documento={{estudiante_doc}}&actor_email={{entrenador_email}}",
              "host": [
                "{{base}}"
              ],
              "path": [
                "students",
                "lookup"
              ],
              "query": [
                {
                  "key": "documento",
                  "value": "{{estudiante_doc}}"
                },
                {
                  "key": "actor_email",
                  "value": "{{entrenador_email}}"
                }
              ]
            },
            "description": ""
