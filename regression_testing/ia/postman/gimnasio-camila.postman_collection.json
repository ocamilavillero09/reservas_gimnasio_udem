  "item": [
    {
      "name": "Preparación (registrar cuentas)",
      "item": [
        {
          "name": "Registrar administradora",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/auth/register/",
              "host": [
                "{{base}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ana Administradora\",\n  \"email\": \"{{admin_email}}\",\n  \"documento\": \"{{admin_doc}}\"\n}"
            }
          }
        },
        {
          "name": "Registrar entrenador",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/auth/register/",
              "host": [
                "{{base}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tomás Entrenador\",\n  \"email\": \"{{entrenador_email}}\",\n  \"documento\": \"{{entrenador_doc}}\"\n}"
            }
          }
        },
        {
          "name": "Registrar estudiante",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/auth/register/",
              "host": [
                "{{base}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Laura Estudiante\",\n  \"email\": \"{{estudiante_email}}\",\n  \"documento\": \"{{estudiante_doc}}\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "0. Sesiones",
      "item": [
        {
          "name": "Login entrenador",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/auth/login/",
              "host": [
                "{{base}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{entrenador_email}}\",\n  \"documento\": \"{{entrenador_doc}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 y devuelve token', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token_entrenador', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login administradora",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/auth/login/",
              "host": [
                "{{base}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"documento\": \"{{admin_doc}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 y devuelve token', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token_admin', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login estudiante",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/auth/login/",
              "host": [
                "{{base}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{estudiante_email}}\",\n  \"documento\": \"{{estudiante_doc}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 y devuelve token', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token_estudiante', pm.response.json().token);"
                ]
              }
            }
          ]
        }
      ]
