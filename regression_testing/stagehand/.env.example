# Copia este archivo como .env y pon tu clave. El .env no se sube al repositorio.
# Proveedor/modelo en formato de Stagehand: google/…, openai/… o anthropic/…
MODELO=google/gemini-3-flash-preview
LLM_API_KEY=pon-aqui-tu-clave

# Sistema bajo prueba (por defecto, docker compose up -d)
FRONT_URL=http://localhost:5173
API_URL=http://localhost:8000/api
MONGO_URI=mongodb://localhost:27017
MONGO_DB=gym_udem

# Espera mínima entre llamadas al modelo (ms). La capa gratuita admite 5 por minuto.
LLM_INTERVALO_MS=13000
