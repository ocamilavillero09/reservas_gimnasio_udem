{
  "name": "udem-gym-front",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "cy:open": "cypress open",
    "cy:api": "cypress run --e2e --spec \"../regression_testing/cypress/e2e/api/**/*.cy.js\" --env informe=api",
    "cy:ui": "cypress run --e2e --spec \"../regression_testing/cypress/e2e/ui/**/*.cy.js\" --env informe=ui",
    "cy:componentes": "cypress run --component --spec \"../regression_testing/cypress/component/regresion/**/*.cy.jsx\" --env informe=componentes",
    "cy:regresion": "npm run cy:api && npm run cy:ui && npm run cy:componentes",
    "cy:defectos:e2e": "cypress run --e2e --spec \"../regression_testing/cypress/e2e/defectos/**/*.cy.js\" --config retries=0 --env informe=defectos-e2e",
    "cy:defectos:componentes": "cypress run --component --spec \"../regression_testing/cypress/component/defectos/**/*.cy.jsx\" --config retries=0 --env informe=defectos-componentes",
    "cy:seguridad": "cypress run --e2e --spec \"../regression_testing/cypress/e2e/seguridad/controles.cy.js\" --env informe=seguridad-controles",
    "cy:vulnerabilidades": "cypress run --e2e --spec \"../regression_testing/cypress/e2e/seguridad/vulnerabilidades.cy.js\" --config retries=0 --env informe=seguridad-vulnerabilidades",
    "cy:accesibilidad": "cypress run --e2e --spec \"../regression_testing/cypress/e2e/ux/accesibilidad.cy.js\" --config retries=0 --env informe=accesibilidad",
    "cy:interfaz": "cypress run --e2e --spec \"../regression_testing/cypress/e2e/ux/interfaz.cy.js\" --config retries=0 --env informe=interfaz",
    "cy:hallazgos": "cypress run --e2e --spec \"../regression_testing/cypress/e2e/ux/hallazgos.cy.js\" --config retries=0 --env informe=hallazgos"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^1.6.0",
    "axe-core": "^4.14.0",
    "cypress": "^13.17.0",
    "cypress-axe": "^1.7.0",
    "cypress-mochawesome-reporter": "^3.8.4",
    "jsdom": "^24.0.0",
    "lighthouse": "^12.8.2",
    "mongodb": "^6.21.0",
    "puppeteer-core": "^23.11.1",
    "vite": "^4.4.0",
    "vite-plugin-pwa": "^0.17.5",
    "vitest": "^1.6.0"
  }
}
